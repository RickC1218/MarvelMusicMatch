# --- Servidor ---
PORT=5000
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma. En desarrollo usa el puerto de Vite.
CORS_ORIGINS=http://localhost:5173

# --- MongoDB ---
# Opción recomendada: una sola URI.
# MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/marvelmusic?retryWrites=true&w=majority
# Alternativa por partes (compatibilidad con la configuración existente).
MONGO_USER=tu_usuario
MONGO_PASSWORD=tu_password
MONGO_DATABASE=marvelmusic
MONGO_CLUSTER=tu_cluster

# --- Marvel API (DEPRECADA) ---
# La API pública de Marvel fue dada de baja. Los personajes se cargan desde el
# dataset local: backend/data/marvel_characters.csv + src/scripts/generateTopCharacters.ts
# MARVEL_PUBLIC_KEY=tu_public_key
# MARVEL_PRIVATE_KEY=tu_private_key

# --- Spotify (SOLO backend) ---
SPOTIFY_CLIENT_ID=tu_client_id
SPOTIFY_CLIENT_SECRET=tu_client_secret
# Mercado para las búsquedas (ISO 3166-1 alpha-2). Ej: US, ES, MX, AR, CO.
SPOTIFY_MARKET=US

# --- IA (SOLO backend) ---
# Orden de proveedores: 'openai', 'gemini' o 'auto' (OpenAI y Gemini de respaldo).
AI_PROVIDER=auto

# OpenAI
OPENAI_API_KEY=tu_api_key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (respaldo; el plan gratuito de AI Studio sirve)
GEMINI_API_KEY=tu_api_key
GEMINI_MODEL=gemini-3.6-flash
